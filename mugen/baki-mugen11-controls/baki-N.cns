; 立ち弱パンチ

[Statedef 200]
type     = S 
movetype = A 
physics  = S
ctrl     = 0
vel = 0,0
sprpriority = 2
anim = 200

[State 200, 食らい上書き]
type = HitOverRide
triggerall = palno = 12
triggerall = var(25)=1
trigger1 = 1
time = 1
attr = SCA, AA,AP,AT
forceair = ifelse((!Alive),1,0)
stateno = 1008
IgnoreHitPause = 1
;*******************************
[State ,];補正リセット
type = Varset
trigger1 = moveguarded
trigger2 = EnemyNear,movetype != H
trigger3 = EnemyNear,statetype = L
trigger4 = EnemyNear,GethitVar(hitcount) <= 0
trigger5 = EnemyNear,ctrl
fvar(6) = 1
ignorehitpause = 1

[State , アタック]
