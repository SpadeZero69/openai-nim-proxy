trigger1 = (fVar(6)<= 0.9)
trigger1 = (Var(25)=0)
value = (0.8 * fVar(6)*1.3)
ignorehitpause = 1
[State , アタック]
type = AttackMulSet
trigger1 = (palno!=[11,12])&&(Var(13)>0)
trigger1 = (fVar(6)<= 0.9)
value = (0.8 * fVar(6)*1.1)
ignorehitpause = 1
[State , アタック]
