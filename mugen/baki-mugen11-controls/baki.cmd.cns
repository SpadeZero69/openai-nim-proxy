;==============================================================================
; Baki Hanma - command file
; Original character by tokage (WinMUGEN, 2014)
; Controls converted to the standard MUGEN 1.1 six-button layout.
;
;   x = Light Punch    y = Medium Punch    z = Heavy Punch
;   a = Light Kick     b = Medium Kick     c = Heavy Kick
;   s = Start (Taunt)
;
; Every move from the original 4-button layout (x, y, a, b) still uses its
; original input. z and c were unused; they now have their own normals and work
; as the "strong" buttons for specials and supers (z works like y, c works like
; b). The full move list is in "Baki - Move List (MUGEN 1.1).txt".
;
; All command names from the original file are kept, including the Japanese
; ones and some that this character never uses itself ("up", "fwd", "back",
; "down", ...): other files such as common1.cns can refer to them.
; This file is Shift-JIS (Japanese ANSI) encoded. If you edit it, save it in
; that same encoding, not UTF-8, or the Japanese command names will break.
;
; Notation: F = forward, B = back, U = up, D = down (relative to facing)
;           QCF = D, DF, F    QCB = D, DB, B
;==============================================================================

;-| Button Remapping |---------------------------------------------------------
; Left side = button name used in this file, right side = the button you
; press. Change the right side to move a button for this character only.
; Example: "z = c" makes pressing c count as z.
[Remap]
x = x
y = y
z = z
a = a
b = b
c = c
s = s

;-| Default Values |-----------------------------------------------------------
[Defaults]
; Default time limit (in ticks, 1/60 s) to enter a command.
command.time = 15

; Default number of ticks a completed command stays active.
command.buffer.time = 1

