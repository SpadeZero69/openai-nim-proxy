;==============================================================================
; Super Motions
;==============================================================================
;-| Breathless Rush (3 bars): D, F, D, B + y or z |-----------------------------
[Command]
name = "無呼吸乱舞"
command = ~D, F, D, B, y
time = 25
buffer.time = 3

[Command]
name = "無呼吸乱舞"   ;NEW: z version
command = ~D, F, D, B, z
time = 25
buffer.time = 3

;-| Triceratops Fist (2 bars): QCF, QCF + y or z |------------------------------
