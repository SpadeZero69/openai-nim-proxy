command = /$D,a
time = 1
buffer.time = 3

[Command]
name = "down_b"
command = /$D,b
time = 1
buffer.time = 3

[Command]
name = "down_y"
command = /$D,y
time = 1
buffer.time = 3

;==============================================================================
; Held Buttons
; The Whip Strike charge (baki-S.cns) uses the hold-x / hold-a commands to keep
; charging, and the two cancel commands (held y or z / held b or c) to cancel.
; The other hold commands are kept from the original file.
;==============================================================================
[Command]
name = "おしっぱなしx"
command = /$x
time = 1

[Command]
name = "おしっぱなしy"
command = /$y
time = 1

[Command]
name = "おしっぱなしa"
command = /$a
time = 1

[Command]
name = "おしっぱなしb"
command = /$b
time = 1

[Command]
name = "おしっぱなしz"
command = /$z
time = 1

[Command]
name = "おしっぱなしc"
command = /$c
time = 1

;-| Whip Strike charge cancel: hold b or c |-----------------------------------
[Command]
name = "おb"
command = /b
time = 1

[Command]
name = "おb"   ;NEW: c also cancels
command = /c
time = 1

;-| Whip Strike charge cancel: hold y or z |-----------------------------------
[Command]
name = "おy"
command = /y
time = 1

[Command]
name = "おy"   ;NEW: z also cancels
command = /z
time = 1

;-| Aliases of the Whip Strike commands above, used by the first version of |-
;-| this conversion, so that version's baki-S.cns also loads.              |-
[Command]
name = "hold_x"
command = /$x
time = 1

[Command]
name = "hold_a"
command = /$a
time = 1

[Command]
name = "hold_yz"
command = /y
time = 1

[Command]
name = "hold_yz"
command = /z
time = 1

[Command]
name = "hold_bc"
command = /b
time = 1

[Command]
name = "hold_bc"
command = /c
time = 1

