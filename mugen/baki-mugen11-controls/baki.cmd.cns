;==============================================================================
; Movement
;==============================================================================
;---------------------------------------------------------------------------
; Dash: F, F
[State -1, Dash]
type = ChangeState
value = 100
triggerall = !var(59)
triggerall = command = "FF"
triggerall = command = "holdfwd"
triggerall = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Back step: B, B
[State -1, Back Step]
type = ChangeState
value = 105
triggerall = hitpausetime = 0
triggerall = !var(59)
triggerall = command = "BB"
triggerall = command = "holdback"
triggerall = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Triangle (wall) jump: in the air next to the screen edge, hold U + the
; direction away from the wall
[State -1, Triangle Jump]
type = ChangeState
value = 99
triggerall = var(59) <= 0
triggerall = command = "holdup"
triggerall = (command = "holdfwd" && BackEdgeBodyDist <= 0) || (command = "holdback" && FrontEdgeBodyDist <= 10)
triggerall = statetype = A
trigger1 = ctrl && pos y <= -50 && stateno != [45,46]
trigger1 = (anim != [41,42])
trigger1 = (stateno != 99)||(anim != 99)

;==============================================================================
; Throws
;==============================================================================
;---------------------------------------------------------------------------
; Back throw (Ura-nage): B + x + y
[State -1, Back Throw]
type = ChangeState
value = 801
triggerall = !var(59)
triggerall = command = "holdback"
triggerall = command = "掴み"
triggerall = command = "y"
triggerall = command = "x"
triggerall = statetype != A
triggerall = stateno != 100
triggerall = !var(25)
trigger1 = ctrl

;---------------------------------------------------------------------------
; Throw (Tenrenge): x + y
[State -1, Throw]
type = ChangeState
value = 800
triggerall = !var(59)
triggerall = command = "掴み"
triggerall = command = "y"
triggerall = command = "x"
triggerall = statetype != A
triggerall = stateno != 100
triggerall = !var(25)
trigger1 = ctrl

;---------------------------------------------------------------------------
; Back throw, standard input: B + z when close
; Only fires when the grab can connect; otherwise B + z gives the elbow.
[State -1, Back Throw close]
type = ChangeState
value = 801
triggerall = !var(59)
triggerall = command = "holdback"
triggerall = command = "z"
triggerall = command != "holddown"
triggerall = statetype != A
triggerall = stateno != 100
triggerall = !var(25)
triggerall = p2bodydist x = [-20,10]
triggerall = (p2statetype = S) || (p2statetype = C)
triggerall = p2movetype != H
triggerall = p2stateno != [130,159]
trigger1 = ctrl

;---------------------------------------------------------------------------
; Throw, standard input: F + z when close
; Only fires when the grab can connect; otherwise F + z gives the elbow.
[State -1, Throw close]
type = ChangeState
value = 800
triggerall = !var(59)
triggerall = command = "holdfwd"
triggerall = command = "z"
triggerall = command != "holddown"
triggerall = statetype != A
triggerall = stateno != 100
triggerall = !var(25)
triggerall = p2bodydist x = [-20,10]
triggerall = (p2statetype = S) || (p2statetype = C)
triggerall = p2movetype != H
triggerall = p2stateno != [130,159]
trigger1 = ctrl

;==============================================================================
