type = ChangeState
value = 780
triggerall = !var(59)
triggerall = power >= 1000
triggerall = (StateNo = [150,153])
triggerall = (InGuardDist)
triggerall = statetype != A
trigger1 = command = "holdfwd" && command = "b"
trigger2 = command = "holdfwd" && command = "y"
trigger3 = command = "holdfwd" && command = "c"
trigger4 = command = "holdfwd" && command = "z"

