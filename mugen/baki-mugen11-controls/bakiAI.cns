
;---------------------------------------------------------------------------------
[Statedef -3];常時監視ステート(EnemyNear(Var(30)),statenoなどで相手に行動を制御された時は実行しない)
;---------------------------------------------------------------------------------
[state -3, a];Ａ.Ｉ.ＬＥＶＥＬ
type = varset
triggerall = (!ishelper)
trigger1 = (var(58) = 0)
var(58) = 2              ; 1 or 2


[State -3, AIフラグセット]
type = VarSet
triggerall = RoundState = [1,2]
trigger1 = Command = "AI0"
trigger2 = Command = "AI1"
