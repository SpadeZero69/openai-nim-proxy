trigger2 = (var(55) = [0,75])
trigger3 = (stateno=300)
trigger3 = (movehit)&&(movecontact=1)
trigger3 = (P2bodyDist X=[-73,73])&&(enemynear,statetype=A)
trigger3 = (P2Dist Y=[-50,30])
trigger3 = (var(55) = [0,650])&&(enemynear,life > 200)
trigger4 = (stateno=220)
trigger4 = (var(5)-pos x!=[-140,140])&&(var(6)-pos x!=[-140,140])
trigger4 = ((P2bodyDist X=[-65,-1])||(P2bodyDist X=[1,65]))&&(movehit)
trigger4 = ((P2Dist Y=[-60,-30])&&(movecontact<=7))||(P2Dist Y=[-60,-40])
trigger4 = (var(55) = [0,650])&&(enemynear,life > 200)
value = 3000

