trigger37 = Command = "AI36"
trigger38 = Command = "AI37"
trigger39 = Command = "AI38"
trigger40 = Command = "AI39"
trigger41 = Command = "AI40"
trigger42 = Command = "AI41"
trigger43 = Command = "AI42"
trigger44 = Command = "AI43"
trigger45 = Command = "AI44"
trigger46 = Command = "AI45"
trigger47 = Command = "AI46"
trigger48 = Command = "AI47"
trigger49 = Command = "AI48"
trigger50 = Command = "AI49"
trigger51 = Command = "AI50"
var(59) = 1

[State -3, 崩れＫＯ]
type = ChangeState
trigger1 = (PrevStateNo = [120,131]) || (PrevStateNo = [150,153])
trigger1 = (StateNo = 5000) || (StateNo = 5010)
trigger1 = (!Alive) || (Life <= 0) || (Lose)
value = 5950
IgnoreHitPause = 1

[State -3]
type = CtrlSet
triggerall = var(59)
trigger1 = (stateno = [20,21])
trigger1 = (stateno = 100)
value = 0

[State -3]
type = CtrlSet
triggerall = var(59)
trigger1 = (stateno = [20,21])
trigger1 = (roundstate = [3,4])
trigger2 = (stateno = 0)
trigger2 = (roundstate = [3,4])
trigger3 = (stateno = [20,21])
trigger3 = (P2dist X < 0)
trigger4 = (stateno = 100)
trigger4 = (roundstate = [3,4])
value = 1

[State -3]
type = turn
triggerall = var(59)
trigger1 = (stateno = 0)
trigger1 = P2dist X < 0

[State -3, 変数ランダム];出す技のパターン確率
type = VarRandom
trigger1 = (RoundState = 2)
v = 55
range = 1,999
IgnoreHitPause = 1
Persistent = 1

;==============================================================================
; BOSS AI v5 (added for the boss version)
; Runs before the original AI below when the computer controls Baki
; (var(59) = 1) and the boss AI setting at the top of baki-2.cns is on
; (var(57) = 1). Everything here only uses WinMUGEN triggers.
;
;   var(52) = aggression 0-3 (rises as his life drops, 3 when awakened)
;   var(53) = awakened (set in baki-2.cns)
;   var(54) = combo route 1-8, picked at random while he is in neutral
;   var(51) = boss powers active (set in baki-2.cns)
;==============================================================================

;------------------------------------------------------------------------------
; Setup: aggression level (0 above 75% life, 1 above 50%, 2 above 25%,
; 3 below that or when awakened). Higher = attacks, counters and moves more.
[State -3, Boss: aggression from life]
type = VarSet
triggerall = (var(59) = 1) && (var(57) = 1)
trigger1 = 1
var(52) = ifelse(var(53) > 0, 3, ifelse(Life * 4 <= LifeMax, 3, ifelse(Life * 2 <= LifeMax, 2, ifelse(Life * 4 <= LifeMax * 3, 1, 0))))
ignorehitpause = 1

;------------------------------------------------------------------------------
; A new combo route is rolled every frame while he is in neutral, so the
; route is locked in as soon as he starts attacking.
[State -3, Boss: pick a combo route]
type = VarRandom
triggerall = (var(59) = 1) && (var(57) = 1)
trigger1 = (ctrl) || (stateno = 0) || (stateno = 20) || (stateno = 100)
v = 54
range = 1,8

;------------------------------------------------------------------------------
; While one of his attacks is touching the opponent, pin the original AI's
; random roll to 1 so its own combo routes are always followed too.
[State -3, Boss: always continue combos]
type = VarSet
triggerall = (var(59) = 1) && (var(57) = 1)
trigger1 = (movetype = A) && (movecontact)
var(55) = 1

;------------------------------------------------------------------------------
; Counters when he can't block.
; Throws can't be blocked: answer a throw attempt with the Heel Drop,
; which is throw-invincible while it starts.
[State -3, Boss: escape a throw]
type = ChangeState
value = 1000
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (var(25) != 1)
triggerall = (stateno = [0,699]) || (stateno = [1333,1336])
triggerall = (movetype != H)
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,hitdefattr = SCA,NT,ST,HT)
trigger1 = (P2BodyDist X = [-10,30])
trigger1 = (Random < 600)

;------------------------------------------------------------------------------
; Caught in the start-up or recovery of his own attack (so he can't
; block) while the opponent attacks: cancel into an invincible move.
[State -3, Boss: counter out of recovery (Breathless Rush)]
type = ChangeState
value = 3000
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 3000)
triggerall = (movetype = A) && (!movehit)
triggerall = (stateno = [200,699])
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,time <= 8)
trigger1 = (P2BodyDist X = [0,70])
trigger1 = (Random < (30 + 30 * var(52)))

[State -3, Boss: counter out of recovery (Trigger Counter)]
type = ChangeState
value = 2700
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 2000)
triggerall = (var(25) != 1)
triggerall = (enemynear,statetype = S)
triggerall = (movetype = A) && (!movehit)
triggerall = (stateno = [200,699])
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,time <= 8)
trigger1 = (P2BodyDist X = [0,60])
trigger1 = (Random < (25 + 25 * var(52)))

[State -3, Boss: counter out of recovery (Goutaijutsu)]
type = ChangeState
value = 2100
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 1000)
triggerall = (var(25) != 1)
triggerall = (movetype = A) && (!movehit)
triggerall = (stateno = [200,699])
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,time <= 8)
trigger1 = (P2BodyDist X = [0,60])
trigger1 = (Random < (25 + 25 * var(52)))

[State -3, Boss: counter out of recovery (Heel Drop)]
type = ChangeState
value = 1000
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (var(25) != 1)
triggerall = (enemynear,statetype != A)
triggerall = (movetype = A) && (!movehit)
triggerall = (stateno = [200,699])
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,time <= 8)
trigger1 = (P2BodyDist X = [-50,60])
trigger1 = (Random < (25 + 20 * var(52)))

[State -3, Boss: counter out of recovery (Mach Punch)]
type = ChangeState
value = 1644
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (var(25) != 1)
triggerall = (var(51) = 1)
triggerall = (enemynear,statetype != A)
triggerall = (movetype = A) && (!movehit)
triggerall = (stateno = [200,699])
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,time <= 8)
trigger1 = (P2BodyDist X = [0,45])
trigger1 = (Random < (20 + 20 * var(52)))

;==============================================================================
; COMBO ROUTES. Each link fires right after the previous hit's hit pause,
; only on a hit (not on block) and only at distances where the next move
; still connects (checked against the moves' frame data).
;   1: crouch jab, straight, strong kick, super/Mach Punch
;   2: jab, elbow, back kick, Trigger Counter/Tackle/Mach Punch
;   3: low kick, middle kick, Triceratops/Himokiri/Whip Strike
;   4: crouch jab, straight, uppercut (launch, air combo) or sweep
;   5: low kick, straight, sweep
;   6: kick, knee, elbow, middle kick, Goutaijutsu/Whip Strike
;   7: jab, straight, Cockroach Tackle/Mach Punch
;   8: crouch jab, straight, back kick, Breathless Rush/Heel Drop/Whip
;==============================================================================

[State -3, Boss: crouch jab > straight]
type = ChangeState
value = 210
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (enemynear,statetype != L)
triggerall = (stateno = 400)
triggerall = (movehit) && (enemynear,movetype = H)
triggerall = (var(54) = 1) || (var(54) = 4) || (var(54) = 8)
trigger1 = (P2BodyDist X = [-20,40])

