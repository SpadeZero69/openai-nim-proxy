trigger1 = (ctrl)||(stateno=20)||(stateno=0)
trigger1 = (P2bodyDist X = [0,70])
trigger1 = (P2Dist Y=[-80,20])&&(enemynear,vel Y >=0)
trigger1 = (var(55) = [0,150])
trigger1 = (enemy,movetype = A)&&(enemynear,time <= 20)
trigger1 =  var(58) = 2
trigger2 = (ctrl)||(stateno=20)||(stateno=0)
trigger2 = (P2bodyDist X = [0,70])
trigger2 = (P2Dist Y=[-80,20])&&(enemynear,vel Y >=0)
trigger2 = (enemy,movetype != H)
