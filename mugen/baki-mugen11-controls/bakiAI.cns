trigger47 = Command = "AI46"
trigger48 = Command = "AI47"
trigger49 = Command = "AI48"
trigger50 = Command = "AI49"
trigger51 = Command = "AI50"
var(59) = 1

[State -3, 崩れＫＯ]
type = ChangeState
trigger1 = (PrevStateNo = [120,131]) || (PrevStateNo = [150,153])
trigger1 = (StateNo = 5000) || (StateNo = 5010)
trigger1 = (!Alive) || (Life <= 0) || (Lose)
value = 5950
IgnoreHitPause = 1

[State -3]
type = CtrlSet
triggerall = var(59)
trigger1 = (stateno = [20,21])
trigger1 = (stateno = 100)
value = 0

[State -3]
type = CtrlSet
triggerall = var(59)
trigger1 = (stateno = [20,21])
trigger1 = (roundstate = [3,4])
trigger2 = (stateno = 0)
trigger2 = (roundstate = [3,4])
trigger3 = (stateno = [20,21])
trigger3 = (P2dist X < 0)
trigger4 = (stateno = 100)
trigger4 = (roundstate = [3,4])
value = 1

[State -3]
type = turn
triggerall = var(59)
trigger1 = (stateno = 0)
trigger1 = P2dist X < 0

[State -3, 変数ランダム];出す技のパターン確率
type = VarRandom
trigger1 = (RoundState = 2)
v = 55
range = 1,999
IgnoreHitPause = 1
Persistent = 1


;==============================================================================
; BOSS AI (added for the boss version)
; Runs before the original AI below when the computer controls Baki
; (var(59) = 1) and the boss AI setting at the top of baki-2.cns is on
; (var(57) = 1). Chances use var(55), a random number from 1 to 999 rolled
; every frame, so [0,20] means about 2% per frame.
;==============================================================================

;------------------------------------------------------------------------------
; Combo engine: while one of Baki's attacks is touching the opponent, pin the
; roll to 1 so the original AI's combo routes below are always followed.
; They end in supers whenever Baki has the meter.
[State -3, Boss: always continue combos]
type = VarSet
triggerall = (var(59) = 1) && (var(57) = 1)
trigger1 = (movetype = A) && (movecontact)
var(55) = 1

;------------------------------------------------------------------------------
; Reversals: early in an opponent's attack close by, answer with an
; invincible move instead of blocking.
[State -3, Boss: reversal Breathless Rush]
type = ChangeState
value = 3000
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 3000)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,time <= 10)
triggerall = (P2BodyDist X = [0,80])
triggerall = (P2Dist Y = [-80,20])
trigger1 = (var(55) = [0,20])

[State -3, Boss: reversal Trigger Counter]
type = ChangeState
value = 2700
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 2000)
triggerall = (var(25) != 1)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,statetype = S)
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,time <= 10)
triggerall = (P2BodyDist X = [0,60])
trigger1 = (var(55) = [21,40])

[State -3, Boss: reversal Tiger King]
type = ChangeState
value = 2310
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (power >= 1000)
triggerall = (var(25) != 1)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,statetype != L)
triggerall = (enemynear,hitdefattr = SCA,NA,SA,HA)
triggerall = (enemynear,time < 30)
triggerall = (P2BodyDist X = [0,70])
triggerall = (P2Dist Y = [-120,20])
trigger1 = (var(55) = [41,80])

[State -3, Boss: reversal Heel Drop]
type = ChangeState
value = 1000
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (var(25) != 1)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,statetype != A)
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,time <= 10)
triggerall = (P2BodyDist X = [-60,60])
trigger1 = (var(55) = [81,100])

[State -3, Boss: reversal Mach Punch]
type = ChangeState
value = 1644
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (var(25) != 1)
triggerall = (var(56) = 1)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,statetype != A)
triggerall = (enemynear,movetype = A)
triggerall = (enemynear,time <= 10)
triggerall = (P2BodyDist X = [0,45])
trigger1 = (var(55) = [101,115])

;------------------------------------------------------------------------------
; Anti-air: kick jumping opponents out of the air (the kick has armor).
[State -3, Boss: anti-air kick]
type = ChangeState
value = 220
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20) || (stateno = 100)
triggerall = (enemynear,statetype = A)
triggerall = (enemynear,movetype != H)
trigger1 = ((enemynear,vel x > 0) && (P2BodyDist X = [40,60])) || ((enemynear,vel x = 0) && (P2BodyDist X = [0,20]))
trigger1 = (enemynear,vel y > 0)
trigger1 = (P2Dist Y = [-120,-80])
trigger1 = (var(55) = [0,600])

;------------------------------------------------------------------------------
; Guard cancel (1 bar) out of blocked attacks.
[State -3, Boss: guard cancel]
type = ChangeState
value = 780
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (power >= 1000)
triggerall = (StateType != A)
triggerall = (StateNo = [150,153])
triggerall = (InGuardDist)
trigger1 = (P2BodyDist X = [-10,55])
trigger1 = (P2Dist Y >= -10)
trigger1 = (var(55) = [0,50])

;------------------------------------------------------------------------------
; Block: high guard chance against any attack in range. The guard states
; (baki.cns) choose standing or crouching guard by themselves.
[State -3, Boss: guard]
type = ChangeState
value = 120
triggerall = (var(59) = 1) && (var(57) = 1)
triggerall = (Alive) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (stateno != [105,106])
triggerall = (stateno != [120,131])
triggerall = (stateno != [150,155])
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (p2movetype = A)
triggerall = (InGuardDist)
triggerall = (var(25) != 1) || (P2BodyDist X != [-90,90])
trigger1 = (Random < 950)

;------------------------------------------------------------------------------
; Pressure: dash in when the opponent is far away and not attacking.
[State -3, Boss: dash in]
type = ChangeState
value = 100
triggerall = (var(59) = 1) && (var(57) = 1) && (hitpausetime = 0)
triggerall = (Alive) && (NumEnemy) && (RoundState = 2)
triggerall = (StateType != A)
triggerall = (stateno != 100)
triggerall = (ctrl) || (stateno = 0) || (stateno = 20)
triggerall = (enemynear,movetype != A)
trigger1 = (P2BodyDist X > 90)
trigger1 = (var(55) = [0,100])
;==============================================================================
; End of BOSS AI. The original AI follows.
;==============================================================================

[State -3, 乱舞]
